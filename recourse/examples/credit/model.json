{
  "name": "Example credit scorecard",
  "outcome": {
    "positive": "approved",
    "negative": "declined"
  },
  "intercept": 0.6,
  "threshold": 0,
  "notes": [
    "Synthetic example. Weights are illustrative, not taken from any real lender.",
    "Effort points are a policy choice: 1 point ≈ one month of sustained, realistic effort."
  ],
  "features": {
    "income_k": {
      "label": "Annual income",
      "unit": "$k",
      "weight": 0.035,
      "reference": 55,
      "mutable": true,
      "direction": "increase",
      "max_change": 15,
      "step": 1,
      "cost": 0.15
    },
    "utilization_pct": {
      "label": "Credit utilisation",
      "unit": "%",
      "weight": -0.03,
      "reference": 35,
      "mutable": true,
      "direction": "decrease",
      "min": 5,
      "step": 1,
      "cost": 0.06,
      "max_change": 40
    },
    "debt_k": {
      "label": "Outstanding debt",
      "unit": "$k",
      "weight": -0.04,
      "reference": 15,
      "mutable": true,
      "direction": "decrease",
      "min": 0,
      "max_change": 10,
      "step": 0.5,
      "cost": 0.2
    },
    "missed_payments_24m": {
      "label": "Missed payments (24 mo)",
      "weight": -0.55,
      "reference": 0,
      "note": "only ages out with time"
    },
    "history_years": {
      "label": "Credit history",
      "unit": "yrs",
      "weight": 0.06,
      "reference": 8,
      "note": "only grows with time"
    },
    "area_risk_index": {
      "label": "Area risk index",
      "weight": -2.0,
      "reference": 0.3,
      "note": "set by home postcode; a likely geographic proxy for race and income"
    }
  }
}
